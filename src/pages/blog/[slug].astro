---
import {
  getEmDashEntry,
  getEmDashCollection,
  getSeoMeta,
  type PortableTextBlock,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import { Comments } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Newsletter from "../../components/Newsletter.astro";
import InlineCTA from "../../components/InlineCTA.astro";
import YouTube from "../../components/YouTube.astro";
import TableOfContents from "../../components/TableOfContents.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
  siteTitle: "Burger Gelato Media",
  siteUrl: Astro.url.origin,
  path: `/blog/${slug}`,
});

// Category terms
const categoryTerms = post.data.terms?.category || [];
const primaryCategory = categoryTerms[0]?.label || "Article";
const primaryCategorySlug = categoryTerms[0]?.slug || "article";

// Author
const authorName = post.data.byline?.displayName || "Chris Latham";
const authorAvatar = post.data.byline?.avatarMediaId
  ? `/_emdash/api/media/file/${post.data.byline.avatarMediaId}`
  : "/images/avatars/chris-latham-profile.webp";

// Publish Date
const pubDate = post.data.publishedAt || post.data.createdAt;
const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

// Category color mappings
const categoryClassMap: Record<string, string> = {
  "SEO": "badge-seo",
  "seo": "badge-seo",
  "Paid Ads": "badge-paid-ads",
  "paid-ads": "badge-paid-ads",
  "Digital Strategy": "badge-digital-strategy",
  "digital-strategy": "badge-digital-strategy",
  "Marketing Automation": "badge-marketing-automation",
  "marketing-automation": "badge-marketing-automation",
  "AI Content": "badge-ai-content",
  "ai-content": "badge-ai-content",
  "Email Marketing": "badge-email-marketing",
  "email-marketing": "badge-email-marketing",
};

// Extract Headings for Table of Contents
function extractHeadings(blocks?: PortableTextBlock[]) {
  if (!blocks) return [];
  const headings: Array<{ depth: number; slug: string; text: string }> = [];
  for (const block of blocks) {
    if (block._type === "block" && (block.style === "h2" || block.style === "h3")) {
      const text = ((block as any).children || []).map((c: any) => c.text || "").join("");
      const headingSlug = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
      headings.push({
        depth: block.style === "h2" ? 2 : 3,
        slug: headingSlug,
        text,
      });
    }
  }
  return headings;
}

const headings = extractHeadings(post.data.content);

// Estimate Reading Time
function estimateReadingTime(blocks?: PortableTextBlock[], excerpt = "") {
  let wordCount = excerpt.split(/\s+/).length * 5;
  if (blocks) {
    for (const b of blocks) {
      if (b._type === "block" && (b as any).children) {
        for (const c of (b as any).children) {
          if (c.text) wordCount += c.text.split(/\s+/).length;
        }
      }
    }
  }
  return Math.max(1, Math.ceil(wordCount / 200));
}

const readingTime = estimateReadingTime(post.data.content, post.data.excerpt);

// Related posts
const { entries: allPosts } = await getEmDashCollection("posts", {
  where: primaryCategorySlug ? { category: primaryCategorySlug } : undefined,
  limit: 4,
});

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .slice(0, 3);

// Custom PortableText block types
const customBlockComponents = {
  inlineCTA: InlineCTA,
  youtube: YouTube,
};

const postUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(postUrl);
const encodedTitle = encodeURIComponent(post.data.title);
---

<Base
  title={seo.title || post.data.title}
  description={seo.description || post.data.excerpt}
  image={post.data.featured_image?.src}
  type="article"
  publishedTime={pubDate ? new Date(pubDate).toISOString() : undefined}
  author={authorName}
  content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="breadcrumb-inner">
      <a href="/" class="crumb-link">Home</a>
      <span class="crumb-sep">/</span>
      <a href="/archive" class="crumb-link">Archive</a>
      <span class="crumb-sep">/</span>
      <a href={`/categories/${primaryCategorySlug}`} class="crumb-link">
        {primaryCategory}
      </a>
    </div>
  </div>

  <article class="post-article">
    <!-- Header -->
    <header class="post-header">
      <!-- Category Badges -->
      <div class="category-badge-list">
        {
          categoryTerms.map((cat) => (
            <a
              href={`/categories/${cat.slug}`}
              class={`category-badge ${categoryClassMap[cat.slug] || "badge-default"}`}
            >
              {cat.label}
            </a>
          ))
        }
      </div>

      <!-- Title -->
      <h1 class="post-main-title" {...post.edit.title}>
        {post.data.title}
      </h1>

      <!-- Meta Row -->
      <div class="post-meta-row">
        <!-- Author + Date -->
        <div class="post-author-box">
          <img
            src={authorAvatar}
            alt={authorName}
            class="post-author-avatar"
          />
          <div>
            <p class="post-author-name">{authorName}</p>
            <div class="post-meta-sub">
              {formattedDate && <time>{formattedDate}</time>}
              <span class="meta-dot">·</span>
              <span>{readingTime} min read</span>
            </div>
          </div>
        </div>

        <!-- Share Buttons -->
        <div class="post-share-wrap">
          <span class="share-label">Share:</span>
          <a
            href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Twitter"
            class="share-icon-btn"
          >
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.261 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
            class="share-icon-btn"
          >
            <svg class="share-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <button
            id="copy-link-btn"
            aria-label="Copy link"
            class="share-icon-btn"
            data-url={postUrl}
          >
            <svg
              class="share-icon"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Top YouTube embed if configured -->
    {
      (post.data as any).youtube && (
        <div class="post-featured-media-container">
          <YouTube url={(post.data as any).youtube} />
        </div>
      )
    }

    <!-- Featured Image -->
    {
      post.data.featured_image && (
        <div class="post-featured-media-container" {...post.edit.featured_image}>
          <Image
            image={post.data.featured_image}
            class="post-hero-image"
            priority={true}
          />
        </div>
      )
    }

    <!-- Table of Contents -->
    <div class="post-content-container">
      <TableOfContents headings={headings} />
    </div>

    <!-- Portable Text Body -->
    <div class="post-content-container prose-post">
      <PortableText
        value={post.data.content}
        components={{ type: customBlockComponents }}
      />
    </div>

    <!-- Tags Row -->
    {
      categoryTerms.length > 0 && (
        <div class="post-content-container tags-section">
          <span class="tags-label">Topics:</span>
          {categoryTerms.map((cat) => (
            <a href={`/categories/${cat.slug}`} class="post-tag-pill">
              {cat.label}
            </a>
          ))}
        </div>
      )
    }

    <!-- Author Bio Card -->
    <div class="post-content-container">
      <div class="author-bio-card">
        <img
          src={authorAvatar}
          alt={authorName}
          class="author-bio-avatar"
        />
        <div class="author-bio-info">
          <p class="author-bio-name">{authorName}</p>
          <p class="author-bio-role">Digital Marketing Strategist</p>
          <p class="author-bio-desc">
            Helping small businesses grow through smart digital marketing. Founder of Burger Gelato Media.
          </p>
        </div>
      </div>
    </div>

    <!-- Newsletter CTA -->
    <div class="post-content-container newsletter-box">
      <Newsletter variant="inline" />
    </div>

    <!-- Comments Section (EmDash Native) -->
    <div class="post-content-container comments-container">
      <Comments collection="posts" contentId={post.data.id} threaded={true} />
    </div>
  </article>

  <!-- Related Posts -->
  {
    relatedPosts.length > 0 && (
      <section class="related-posts-section">
        <div class="related-posts-inner">
          <div class="related-header">
            <div class="accent-bar red-bar" />
            <h2 class="related-title">Keep Reading</h2>
          </div>
          <div class="posts-grid">
            {relatedPosts.map((rel) => {
              const cats = rel.data.terms?.category?.map((t) => t.label) || [];
              return (
                <PostCard
                  title={rel.data.title}
                  excerpt={rel.data.excerpt}
                  slug={rel.id}
                  featuredImage={rel.data.featured_image}
                  date={rel.data.publishedAt || rel.data.createdAt}
                  category={cats.length > 0 ? cats : [primaryCategory]}
                  bylines={rel.data.bylines}
                />
              );
            })}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .breadcrumb-bar {
    background: var(--color-bg-subtle, #f9fafb);
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .breadcrumb-inner {
    max-width: var(--content-width, 760px);
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted, #4b5563);
  }

  .crumb-link {
    color: var(--color-text-secondary, #374151);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .crumb-link:hover {
    color: var(--color-brand, #E5172F);
  }

  .crumb-sep {
    color: var(--color-border, #d1d5db);
  }

  .post-article {
    background: var(--color-bg, #ffffff);
    padding-bottom: 3.5rem;
  }

  .post-header {
    max-width: var(--content-width, 760px);
    margin: 0 auto;
    padding: 2.75rem 1.25rem 1.75rem;
  }

  .category-badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .post-main-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-text, #111827);
    margin-bottom: 1.5rem;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .post-author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .post-author-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px #f3f4f6;
  }

  .post-author-name {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text, #111827);
    margin: 0;
  }

  .post-meta-sub {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted, #4b5563);
    margin-top: 0.15rem;
  }

  .meta-dot {
    color: var(--color-border, #d1d5db);
  }

  .post-share-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .share-label {
    font-size: 0.8125rem;
    color: var(--color-muted, #4b5563);
    font-weight: 600;
    margin-right: 0.25rem;
  }

  .share-icon-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-bg-subtle, #f3f4f6);
    border: 1px solid var(--color-border, #e5e7eb);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary, #374151);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-icon-btn:hover {
    background: var(--color-brand, #E5172F);
    color: #ffffff;
    border-color: var(--color-brand, #E5172F);
    transform: translateY(-1px);
  }

  .share-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .post-featured-media-container {
    max-width: var(--content-width, 760px);
    margin: 0 auto 2rem;
    padding: 0 1.25rem;
  }

  .post-hero-image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .post-content-container {
    max-width: var(--content-width, 760px);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .tags-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-muted, #4b5563);
    letter-spacing: 0.08em;
  }

  .post-tag-pill {
    font-size: 0.8125rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-text-secondary, #374151);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .post-tag-pill:hover {
    border-color: var(--color-brand, #E5172F);
    color: var(--color-brand, #E5172F);
  }

  .author-bio-card {
    margin-top: 2.5rem;
    background: var(--color-bg-subtle, #f9fafb);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .author-bio-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px #ffffff;
  }

  .author-bio-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text, #111827);
    margin: 0 0 0.25rem;
  }

  .author-bio-role {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand, #E5172F);
    margin: 0 0 0.5rem;
  }

  .author-bio-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .newsletter-box {
    margin-top: 3rem;
  }

  .comments-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
  }

  .related-posts-section {
    background: var(--color-bg-subtle, #f9fafb);
    padding: 3.5rem 1.25rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
  }

  .related-posts-inner {
    max-width: var(--wide-width, 1180px);
    margin: 0 auto;
  }

  .related-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .accent-bar {
    width: 4px;
    height: 1.5rem;
    border-radius: 9999px;
  }

  .red-bar {
    background-color: var(--color-brand, #E5172F);
  }

  .related-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text, #111827);
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const copyBtn = document.getElementById("copy-link-btn");
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url") || window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      const originalHTML = copyBtn.innerHTML;
      copyBtn.innerHTML = `<svg class="share-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      copyBtn.style.backgroundColor = "#10b981";
      copyBtn.style.color = "#ffffff";
      setTimeout(() => {
        copyBtn.innerHTML = originalHTML;
        copyBtn.style.backgroundColor = "";
        copyBtn.style.color = "";
      }, 2000);
    } catch (_) {}
  });
</script>
