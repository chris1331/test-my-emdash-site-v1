---
import {
  getEmDashCollection,
  getSiteSettingsWithCacheHint,
  getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [postsResult, settingsResult, termsResult] = await Promise.all([
  getEmDashCollection("posts", {
    orderBy: { published_at: "desc" },
    limit: 25,
  }),
  getSiteSettingsWithCacheHint(),
  getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);

if (Astro.cache?.enabled) {
  Astro.cache.set(postsResult.cacheHint);
  Astro.cache.set(settingsResult.cacheHint);
  Astro.cache.set(termsResult.cacheHint);
}

const posts = postsResult.entries;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);

// Featured = 3 most recent
const featured = posts.slice(0, 3);
// Remaining articles for grid
const articles = posts.slice(3);

const categoryTerms = termsResult.data || [];
---

<Base title={siteTitle} description={siteTagline}>
  <!-- Hero banner -->
  <Newsletter variant="hero" />

  <!-- Topic pills bar -->
  <section class="topic-bar">
    <div class="topic-bar-inner">
      <span class="topic-label">Browse by topic:</span>
      <div class="topic-list">
        {
          categoryTerms.map((cat) => (
            <a href={`/categories/${cat.slug}`} class="topic-bar-pill">
              {cat.label}
            </a>
          ))
        }
      </div>
      <a href="/archive" class="topic-all-link">
        All posts
        <svg
          class="arrow-icon"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    </div>
  </section>

  <div class="home-main-container">
    {
      posts.length === 0 ? (
        <section class="empty-state">
          <h2>No posts yet</h2>
          <p>Create your first post in the EmDash admin panel.</p>
          <a href="/_emdash/admin/content/posts/new" class="btn-primary">
            Create a post
          </a>
        </section>
      ) : (
        <>
          <!-- Featured section -->
          <section class="home-section">
            <div class="section-header">
              <div class="section-title-wrap">
                <div class="accent-bar red-bar" />
                <h2 class="section-title">Featured</h2>
              </div>
              <a href="/archive" class="view-all-link">
                View all
                <svg
                  class="arrow-icon"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </div>

            <div class="posts-grid">
              {featured.map((post) => {
                const cats = post.data.terms?.category?.map((t) => t.label) || [];
                return (
                  <PostCard
                    title={post.data.title}
                    excerpt={post.data.excerpt}
                    slug={post.id}
                    featuredImage={post.data.featured_image}
                    date={post.data.publishedAt || post.data.createdAt}
                    category={cats.length > 0 ? cats : "Article"}
                    bylines={post.data.bylines}
                    featured={true}
                    edit={post.edit}
                  />
                );
              })}
            </div>
          </section>

          <!-- Articles section -->
          {articles.length > 0 && (
            <section class="home-section articles-section">
              <div class="section-header">
                <div class="section-title-wrap">
                  <div class="accent-bar gray-bar" />
                  <h2 class="section-title">Articles</h2>
                </div>
                <span class="count-label">{articles.length} posts</span>
              </div>

              <div class="posts-grid">
                {articles.slice(0, 6).map((post) => {
                  const cats = post.data.terms?.category?.map((t) => t.label) || [];
                  return (
                    <PostCard
                      title={post.data.title}
                      excerpt={post.data.excerpt}
                      slug={post.id}
                      featuredImage={post.data.featured_image}
                      date={post.data.publishedAt || post.data.createdAt}
                      category={cats.length > 0 ? cats : "Article"}
                      bylines={post.data.bylines}
                      edit={post.edit}
                    />
                  );
                })}
              </div>

              {articles.length > 6 && (
                <div class="load-more-wrap">
                  <a href="/archive" class="load-more-btn">
                    Load more articles
                    <svg
                      class="arrow-icon"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </a>
                </div>
              )}
            </section>
          )}
        </>
      )
    }
  </div>
</Base>

<style>
  .topic-bar {
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    background: var(--color-surface, #ffffff);
  }

  .topic-bar-inner {
    max-width: var(--wide-width, 1180px);
    margin: 0 auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .topic-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted, #4b5563);
    white-space: nowrap;
  }

  .topic-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .topic-bar-pill {
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-text-secondary, #4b5563);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .topic-bar-pill:hover {
    border-color: var(--color-brand, #E5172F);
    color: var(--color-brand, #E5172F);
  }

  .topic-all-link {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand, #E5172F);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .topic-all-link:hover {
    text-decoration: underline;
  }

  .arrow-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .home-main-container {
    max-width: var(--wide-width, 1180px);
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .home-section {
    margin-bottom: 3.5rem;
  }

  .articles-section {
    margin-bottom: 2rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .accent-bar {
    width: 4px;
    height: 1.5rem;
    border-radius: 9999px;
  }

  .red-bar {
    background-color: var(--color-brand, #E5172F);
  }

  .gray-bar {
    background-color: #d1d5db;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text, #111827);
    margin: 0;
    letter-spacing: -0.015em;
  }

  .view-all-link {
    font-size: 0.875rem;
    color: var(--color-muted, #6b7280);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.15s ease;
  }

  .view-all-link:hover {
    color: var(--color-brand, #E5172F);
  }

  .count-label {
    font-size: 0.875rem;
    color: var(--color-muted, #9ca3af);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .load-more-wrap {
    margin-top: 2.75rem;
    text-align: center;
  }

  .load-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    border-radius: 12px;
    border: 2px solid var(--color-border, #e5e7eb);
    color: var(--color-text, #374151);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .load-more-btn:hover {
    border-color: var(--color-brand, #E5172F);
    color: var(--color-brand, #E5172F);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
  }

  .empty-state h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--color-muted, #6b7280);
    margin-bottom: 1.5rem;
  }
</style>
