<style>
  .inline-cta-container {
    position: relative;
    margin: 2.5rem 0;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    padding: 2.25rem 1.75rem;
    text-align: center;
    background: linear-gradient(135deg, #0d1117 0%, #111827 50%, #1f2937 100%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    color: #ffffff;
  }

  .inline-cta-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--color-brand, #E5172F);
  }

  .inline-cta-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .inline-cta-text {
    color: #9ca3af;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 auto 1.5rem;
    max-width: 540px;
  }

  .inline-cta-btn {
    display: inline-block;
    background: var(--color-brand, #E5172F);
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.8rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .inline-cta-btn:hover {
    background: var(--color-brand-hover, #C01225);
    transform: translateY(-1px);
  }
</style>
