---
import type { ContentBylineCredit, EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
  title: string;
  excerpt?: string;
  slug?: string;
  href?: string;
  featuredImage?: MediaValue | string;
  date?: Date | string | null;
  readingTime?: number;
  category?: string[] | string;
  tags?: Array<{ slug: string; label: string }>;
  author?: string;
  avatarUrl?: string;
  featured?: boolean;
  bylines?: ContentBylineCredit[];
  edit?: EditProxy;
}

const {
  title,
  excerpt = "",
  slug,
  href,
  featuredImage,
  date,
  readingTime = 3,
  category = "Article",
  tags,
  author = "Chris Latham",
  avatarUrl = "/images/avatars/chris-latham-profile.webp",
  featured = false,
  bylines,
  edit,
} = Astro.props;

const targetUrl = href || (slug ? `/blog/${slug}` : "#");
const resolvedCategories = tags ? tags.map((t) => t.label) : (Array.isArray(category) ? category : [category]);
const primaryCategory = resolvedCategories[0] || "Article";

// Category color mappings matching Burger Gelato Media
const categoryClassMap: Record<string, string> = {
  "SEO": "badge-seo",
  "seo": "badge-seo",
  "Paid Ads": "badge-paid-ads",
  "paid-ads": "badge-paid-ads",
  "Digital Strategy": "badge-digital-strategy",
  "digital-strategy": "badge-digital-strategy",
  "Marketing Automation": "badge-marketing-automation",
  "marketing-automation": "badge-marketing-automation",
  "AI Content": "badge-ai-content",
  "ai-content": "badge-ai-content",
  "Email Marketing": "badge-email-marketing",
  "email-marketing": "badge-email-marketing",
};

const badgeClass = categoryClassMap[primaryCategory] || "badge-default";

// Normalize category display label
const categoryLabelMap: Record<string, string> = {
  "seo": "SEO",
  "paid-ads": "Paid Ads",
  "digital-strategy": "Digital Strategy",
  "marketing-automation": "Marketing Automation",
  "ai-content": "AI Content",
  "email-marketing": "Email Marketing",
};
const displayCategory = categoryLabelMap[primaryCategory] || primaryCategory;

const parsedDate = date ? new Date(date) : null;
const formattedDate = parsedDate
  ? parsedDate.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const authorName = bylines?.[0]?.byline.displayName || author;
const authorAvatar = bylines?.[0]?.byline.avatarMediaId
  ? `/_emdash/api/media/file/${bylines[0].byline.avatarMediaId}`
  : avatarUrl;
---

<article class={`bgm-post-card ${featured ? "featured" : ""}`}>
  <!-- Image -->
  <a href={targetUrl} class="card-image-wrap">
    {
      featuredImage ? (
        <div class="card-image-inner" {...edit?.featured_image}>
          <Image image={featuredImage} class="card-img" />
        </div>
      ) : (
        <div class="card-placeholder" />
      )
    }
  </a>

  <!-- Content -->
  <div class="card-content">
    <!-- Category & Read Time -->
    <div class="card-header-row">
      <span class={`category-badge ${badgeClass}`}>
        {displayCategory}
      </span>
      <span class="read-time">{readingTime} min read</span>
    </div>

    <!-- Title -->
    <h2 class={`card-title ${featured ? "title-lg" : "title-md"}`} {...edit?.title}>
      <a href={targetUrl}>{title}</a>
    </h2>

    <!-- Excerpt -->
    {
      excerpt && (
        <p class="card-excerpt" {...edit?.excerpt}>
          {excerpt}
        </p>
      )
    }

    <!-- Author & Date footer -->
    <div class="card-footer-row">
      <img
        src={authorAvatar}
        alt={authorName}
        class="author-avatar"
        loading="lazy"
      />
      <div class="author-meta">
        <span class="author-name">{authorName}</span>
        <span class="meta-dot">·</span>
        {
          parsedDate && (
            <time datetime={parsedDate.toISOString()} class="post-date">
              {formattedDate}
            </time>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .bgm-post-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    border: 1px solid var(--color-border, #e5e7eb);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .bgm-post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    border-color: #d1d5db;
  }

  .card-image-wrap {
    display: block;
    overflow: hidden;
    background: #f3f4f6;
    flex-shrink: 0;
  }

  .card-image-inner {
    width: 100%;
    height: 12.5rem;
    overflow: hidden;
  }

  .bgm-post-card.featured .card-image-inner {
    height: 14rem;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .bgm-post-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-placeholder {
    width: 100%;
    height: 12.5rem;
    background: #f3f4f6;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.35rem;
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }

  .badge-seo {
    background-color: #ecfdf5;
    color: #047857;
  }

  .badge-paid-ads {
    background-color: #eff6ff;
    color: #1d4ed8;
  }

  .badge-digital-strategy {
    background-color: #f5f3ff;
    color: #6d28d9;
  }

  .badge-marketing-automation {
    background-color: #fffbeb;
    color: #b45309;
  }

  .badge-ai-content {
    background-color: #ecfeff;
    color: #0e7490;
  }

  .badge-email-marketing {
    background-color: #fff1f2;
    color: #be123c;
  }

  .badge-default {
    background-color: #f3f4f6;
    color: #4b5563;
  }

  .read-time {
    font-size: 0.75rem;
    color: var(--color-muted, #4b5563);
    font-weight: 500;
  }

  .card-title {
    font-weight: 700;
    color: #111827;
    line-height: 1.35;
    margin-bottom: 0.65rem;
    letter-spacing: -0.015em;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bgm-post-card:hover .card-title a {
    color: var(--color-brand, #E5172F);
  }

  .title-lg {
    font-size: 1.25rem;
  }

  .title-md {
    font-size: 1.0625rem;
  }

  .card-excerpt {
    color: var(--color-text-secondary, #4b5563);
    font-size: 0.875rem;
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .card-footer-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.85rem;
    border-top: 1px solid #f3f4f6;
  }

  .author-avatar {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px #f3f4f6;
  }

  .author-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    min-width: 0;
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text, #111827);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta-dot {
    color: #d1d5db;
  }

  .post-date {
    color: var(--color-muted, #4b5563);
    white-space: nowrap;
  }
</style>
