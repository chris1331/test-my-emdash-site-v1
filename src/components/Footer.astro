---
import { WidgetArea } from "emdash/ui";

const year = new Date().getFullYear();

const categories = [
  { name: "SEO", slug: "seo" },
  { name: "Paid Ads", slug: "paid-ads" },
  { name: "Digital Strategy", slug: "digital-strategy" },
  { name: "Marketing Automation", slug: "marketing-automation" },
  { name: "AI Content", slug: "ai-content" },
  { name: "Email Marketing", slug: "email-marketing" },
];

const footerLinks = [
  { href: "/", label: "Home" },
  { href: "/archive", label: "Archive" },
  { href: "/categories", label: "Categories" },
  { href: "/rss.xml", label: "RSS Feed" },
  { href: "https://burgergelato.com", label: "Our Agency", external: true },
];
---

<footer class="bgm-footer">
  <!-- Top divider line -->
  <div class="footer-divider"></div>

  <!-- Main footer content -->
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo" aria-label="Home">
          <img
            src="/images/logo/logo.png"
            alt="Burger Gelato Media"
            class="footer-logo-img"
          />
          <div>
            <span class="footer-brand-title">Burger Gelato</span>
            <span class="footer-brand-tag">Media</span>
          </div>
        </a>
        <p class="footer-tagline">
          Practical digital marketing insights for small businesses ready to grow smarter, not harder.
        </p>

        <!-- Social links -->
        <div class="social-links">
          <a
            href="https://www.linkedin.com/in/chrislatham/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="social-btn"
          >
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="https://x.com/CoachLatham13"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter / X"
            class="social-btn"
          >
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.261 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@coachlatham"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="social-btn"
          >
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M23.498 6.186a2.997 2.997 0 00-2.11-2.12C19.504 3.545 12 3.545 12 3.545s-7.504 0-9.388.52a2.997 2.997 0 00-2.11 2.12C0 8.08 0 12 0 12s0 3.92.502 5.814a2.997 2.997 0 002.11 2.12c1.884.521 9.388.521 9.388.521s7.504 0 9.388-.52a2.997 2.997 0 002.11-2.12C24 15.92 24 12 24 12s0-3.92-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-list">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="footer-nav-link"
                >
                  {link.label}
                  {link.external && (
                    <svg class="external-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Topics Pills -->
      <div class="footer-topics-col">
        <h4 class="footer-heading">Topics</h4>
        <div class="footer-topics-wrap">
          {
            categories.map((cat) => (
              <a
                href={`/categories/${cat.slug}`}
                class="topic-pill"
              >
                {cat.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Optional EmDash widget area -->
    <div class="footer-widgets">
      <WidgetArea name="footer" />
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom-bar">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {year} Burger Gelato Media. All rights reserved.
      </p>
      <div class="footer-legal-links">
        <a href="/pages/privacy">Privacy Policy</a>
        <a href="/pages/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .bgm-footer {
    background: #0d1117;
    color: #9ca3af;
    margin-top: 4rem;
  }

  .footer-divider {
    background: rgba(255, 255, 255, 0.1);
    height: 1px;
    width: 100%;
  }

  .footer-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1.5fr;
      gap: 3rem;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    height: 2.5rem;
    width: 2.5rem;
    object-fit: contain;
  }

  .footer-brand-title {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.1;
    display: block;
  }

  .footer-brand-tag {
    color: var(--color-brand, #E5172F);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6b7280;
    max-width: 20rem;
    margin-bottom: 1.25rem;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-btn {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    color: #ffffff;
  }

  .social-btn:hover {
    background: var(--color-brand, #E5172F);
    transform: translateY(-2px);
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
  }

  .footer-heading {
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav-link {
    font-size: 0.875rem;
    color: #6b7280;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
  }

  .footer-nav-link:hover {
    color: var(--color-brand, #E5172F);
  }

  .external-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .footer-topics-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .topic-pill {
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #9ca3af;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .topic-pill:hover {
    border-color: var(--color-brand, #E5172F);
    color: var(--color-brand, #E5172F);
    background: rgba(229, 23, 47, 0.05);
  }

  .footer-widgets {
    margin-top: 1.5rem;
  }

  .footer-bottom-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
    }
  }

  .footer-copyright {
    font-size: 0.75rem;
    color: #4b5563;
    margin: 0;
  }

  .footer-legal-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-legal-links a {
    font-size: 0.75rem;
    color: #4b5563;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-legal-links a:hover {
    color: var(--color-brand, #E5172F);
  }
</style>
